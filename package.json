{
  "name": "beambench",
  "version": "1.0.0",
  "description": "3D Optical Laboratory for human and AI interaction - BB84 quantum key distribution teaching",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest",
    "test:unit:run": "vitest --run",
    "test:e2e": "playwright test",
    "test:perf": "vite-node tools/benchmark.ts",
    "verify:docs": "node tools/verify-docs.js",
    "import-upstream": "node tools/import-upstream.js",
    "test:perf:browser": "node tools/perf-browser.mjs",
    "build:standalone": "npm run build && node tools/make-standalone.mjs",
    "build:basic": "npm run typecheck && node tools/build-basic.mjs",
    "pack:optics": "node tools/pack-optics.mjs",
    "verify:optics": "node tools/verify-optics-build.mjs",
    "test:optics:browser": "playwright test --config playwright.optics.config.ts",
    "release": "node tools/make-release.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.18.0",
    "three": "^0.161.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.10.0",
    "@types/three": "^0.161.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "playwright": "^1.40.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
